{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "pwsh.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy Bypass",
                    "-NonInteractive",
                    "-Command"
                ]
            }
        }
    },
    "linux": {
        "options": {
            "shell": {
                "executable": "/usr/bin/pwsh",
                "args": [ "-NoProfile", "-Command" ]
            }
        }
    },
    "osx": {
        "options": {
            "shell": {
                "executable": "/usr/local/bin/pwsh",
                "args": [ "-NoProfile", "-Command" ]
            }
        }
    },
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "group": "build",
            "command": "Invoke-Build Build",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "Invoke-Build Clean",
            "problemMatcher": []
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "Invoke-Build Install",
            "problemMatcher": []
        },
        {
            "label": "Update docs",
            "type": "shell",
            "command": "Invoke-Build Doc.Update",
            "problemMatcher": []
        },
        {
            "label": "All Tests",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Unit Tests",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -Tag UnitTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Integration Tests",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -Tag IntegrationTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Unit Tests: Azure",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter Azure -ExcludeTagFilter IntegrationTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Integration Tests: Azure",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter Azure -ExcludeTagFilter UnitTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Unit Tests: Docker",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter Docker -ExcludeTagFilter IntegrationTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Integration Tests: Docker",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter Docker -ExcludeTagFilter UnitTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Unit Tests: LocalDB",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter SqlLocalDB -ExcludeTagFilter IntegrationTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        },
        {
            "label": "Integration Tests: LocalDB",
            "group": "test",
            "type": "shell",
            "command": "Invoke-Pester -TagFilter SqlLocalDB -ExcludeTagFilter UnitTest",
            "options": {
                "cwd": "${workspaceFolder}/test"
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false
            },
            "dependsOn": "Build"
        }
    ]
}
